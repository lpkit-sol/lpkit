{
  "name": "@lpkit-sol/damm-v2",
  "version": "0.1.0",
  "description": "Read-only helpers for Meteora DAMM v2 pools. Unofficial.",
  "keywords": [
    "solana",
    "meteora",
    "damm",
    "damm-v2",
    "liquidity",
    "amm",
    "lp",
    "defi"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/lpkit-sol/lpkit/tree/main/packages/damm-v2#readme",
  "bugs": {
    "url": "https://github.com/lpkit-sol/lpkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpkit-sol/lpkit.git",
    "directory": "packages/damm-v2"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./classify": {
      "import": {
        "types": "./dist/classify/index.d.ts",
        "default": "./dist/classify/index.js"
      },
      "require": {
        "types": "./dist/classify/index.d.cts",
        "default": "./dist/classify/index.cjs"
      }
    },
    "./presets": {
      "import": {
        "types": "./dist/presets/index.d.ts",
        "default": "./dist/presets/index.js"
      },
      "require": {
        "types": "./dist/presets/index.d.cts",
        "default": "./dist/presets/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lpkit-sol/core": "^0.1.0"
  },
  "peerDependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@meteora-ag/cp-amm-sdk": "^1.5.1",
    "@solana/web3.js": "^1.95.3"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@meteora-ag/cp-amm-sdk": "^1.5.1",
    "@solana/web3.js": "^1.99.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
