{
  "name": "@lpkit-sol/core",
  "version": "0.1.0",
  "description": "Protocol-neutral types for Solana liquidity pools and positions.",
  "keywords": [
    "solana",
    "liquidity",
    "amm",
    "lp",
    "defi"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/lpkit-sol/lpkit/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/lpkit-sol/lpkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpkit-sol/lpkit.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
